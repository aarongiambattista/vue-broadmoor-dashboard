{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/data-api/*", "/static/*", "/*.{png,jpg,gif,js,css}"]
  },
  "routes": [
    {
      "route": "/data-api/*",
      "allowedRoles": ["anonymous", "authenticated"]
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Content-Security-Policy": "default-src 'self' https://*.azurestaticapps.net; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval';"
  }
}