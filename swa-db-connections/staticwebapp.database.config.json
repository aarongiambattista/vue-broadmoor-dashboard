{
  "$schema": "https://github.com/Azure/data-api-builder/releases/download/v0.5.0/dab.draft.schema.json",
  "data-source": {
    "database-type": "mssql",
    "connection-string": "@env('DATABASE_CONNECTION_STRING')"
  },
  "entities": {
    "Weather": {
      "source": "dbo.WeatherData",
      "permissions": [
        {
          "role": "anonymous",
          "actions": [ "read" ]
        }
      ],
      "mappings": {
        "dateutc": "dateutc",
        "tempf": "tempf",
        "humidity": "humidity",
        "windspeedmph": "windspeedmph",
        "baromrelin": "baromrelin",
        "dailyrainin": "dailyrainin",
        "monthlyrainin": "monthlyrainin",
        "lightning_time": "lightning_time",
        "lightning_distance": "lightning_distance"
      }
    }
  }
}